<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas para Android 11 e inferior (en Android 12+ se usa data_extraction_rules.xml).
    No se respalda ningún dato local de la app (ver explicación en data_extraction_rules.xml).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>