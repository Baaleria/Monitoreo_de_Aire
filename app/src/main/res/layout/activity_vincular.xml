<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="24dp">

    <!-- Flecha de retroceso: Ahora está SOLA, más arriba y separada del título -->
    <ImageView
        android:id="@+id/btnAtras"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="8dp"
        android:src="@drawable/baseline_arrow_back_ios_24"
        app:tint="@color/black" />

    <!-- Título: Ahora está debajo de la flecha con una buena separación -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnAtras"
        android:layout_marginTop="24dp"
        android:text="@string/vincular_titulo"
        android:textColor="@color/black"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Línea divisoria gris -->
    <View
        android:id="@+id/divider"
        android:layout_width="150dp"
        android:layout_height="2dp"
        android:layout_below="@id/tvTitle"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:background="@color/gris_linea" />

    <!-- Contenedor del Formulario -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/divider"
        android:orientation="vertical">

        <!-- NUEVO INPUT: Ingresar código con el placeholder solicitado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vincular_codigo_label"
            android:textColor="@color/azul_primario"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_codigo"
            android:maxLength="30"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/vincular_codigo_hint"
            android:textSize="16sp"
            android:paddingVertical="12dp"
            android:backgroundTint="@color/gris_claro"
            android:layout_marginBottom="20dp"/>

        <!-- Campo Nombre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vincular_nombre_label"
            android:textColor="@color/azul_primario"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_nombre"
            android:maxLength="50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/vincular_nombre_hint"
            android:textSize="16sp"
            android:paddingVertical="12dp"
            android:backgroundTint="@color/gris_claro"
            android:layout_marginBottom="20dp"/>

        <!-- Campo Ubicación -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vincular_ubicacion_label"
            android:textColor="@color/azul_primario"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_ubicacion"
            android:maxLength="60"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/vincular_ubicacion_hint"
            android:textSize="16sp"
            android:paddingVertical="12dp"
            android:backgroundTint="@color/gris_claro"
            android:layout_marginBottom="24dp"/>

        <!-- Tarjeta de Íconos -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vincular_icono_label"
                    android:textColor="@color/azul_primario"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gris_claro"
                    android:layout_marginBottom="16dp"/>

                <!-- Cuadrícula de íconos -->
                <!-- Cuadrícula de íconos (Usando los que ya tienes disponibles) -->
                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:rowCount="2"
                    android:alignmentMode="alignBounds">

                    <!-- Fila 1 -->
                    <ImageView
                        android:id="@+id/iconBed"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="12dp"
                        android:src="@drawable/ic_bed_outline"
                        app:tint="@color/gris_icono"/>

                    <ImageView
                        android:id="@+id/iconDevice"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="12dp"
                        android:src="@drawable/baseline_mode_fan_off_24"
                        app:tint="@color/gris_icono"/>

                    <ImageView
                        android:id="@+id/iconEco"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="12dp"
                        android:src="@drawable/ic_bed_outline"
                        app:tint="@color/gris_icono"/>

                    <ImageView
                        android:id="@+id/iconClothes"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="12dp"
                        android:src="@drawable/baseline_mode_fan_off_24"
                        app:tint="@color/gris_icono"/>

                    <!-- Fila 2 -->
                    <ImageView
                        android:id="@+id/iconLeaf"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="12dp"
                        android:src="@drawable/ic_bed_outline"
                        app:tint="@color/gris_icono"/>

                    <ImageView
                        android:id="@+id/iconFan"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="12dp"
                        android:src="@drawable/baseline_mode_fan_off_24"
                        app:tint="@color/gris_icono"/>

                    <ImageView
                        android:id="@+id/iconHome"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="12dp"
                        android:src="@drawable/ic_bed_outline"
                        app:tint="@color/gris_icono"/>

                    <ImageView
                        android:id="@+id/iconBag"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="12dp"
                        android:src="@drawable/baseline_mode_fan_off_24"
                        app:tint="@color/gris_icono"/>
                </GridLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Botón Añadir abajo a la derecha -->
    <Button
        android:id="@+id/btnAnadir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:text="@string/vincular_btn_anadir"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:backgroundTint="@color/azul_primario"
        app:cornerRadius="20dp"
        android:paddingHorizontal="32dp"
        android:paddingVertical="12dp"/>

</RelativeLayout>