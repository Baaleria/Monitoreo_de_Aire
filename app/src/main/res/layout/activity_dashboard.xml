<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/dashboard"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/textDashboard"
        android:textColor="#2196F3"
        android:textSize="20sp"
        android:textStyle="bold" />


    <!-- Configurar texto sensor -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sensor Habitación 1 ⚙️"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="120dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:background="#A9A9A9" />

    <!-- Tarjeta Principal de Calidad de Aire -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvAirQuality"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        app:cardCornerRadius="32dp"
        app:cardBackgroundColor="#4C8DFF"
        app:cardElevation="4dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textCalidad"
                android:textColor="#FFFFFF"
                android:background="#4D000000"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- Configurar valores de calidad de aire!! -->

            <TextView
                android:id="@+id/tvAirStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alta"
                android:textSize="72sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSensorValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valor MQ-135"
                android:textColor="#FFFFFF"
                android:layout_marginTop="32dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Tarjeta del Sistema de Ventilación -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerVertical="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/textVentilador"
                    android:textColor="#2196F3"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/textVentilador2"
                    android:textColor="#000000" />

                <!-- Configurar estado de ventilación -->

                <TextView
                    android:id="@+id/tvFanStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apagado"
                    android:textColor="#F44336" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="❄️"
                android:textSize="48sp" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>