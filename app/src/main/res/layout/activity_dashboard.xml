<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenido principal: dashboard actual -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo_dashboard">

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/dashboard_titulo"
                    android:textColor="@color/azul_primario"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nombre_sensor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="@string/dashboard_cargando"
                    android:textColor="@color/gris_texto"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="150dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:background="@color/gris_linea" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false">

                    <!-- Cuadrado Azul -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/calidad_aire"
                        android:layout_width="match_parent"
                        android:layout_height="420dp"
                        app:cardCornerRadius="48dp"
                        app:cardBackgroundColor="@color/azul_claro"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingBottom="60dp">

                            <!-- Etiqueta calidad de aire -->
                            <TextView
                                android:id="@+id/calidad_aire_lb"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_calidad_aire"
                                android:textColor="@color/white"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_rounded_text"
                                android:paddingHorizontal="24dp"
                                android:paddingVertical="8dp"
                                android:layout_marginBottom="16dp"/>

                            <TextView
                                android:id="@+id/estado_aire"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/valor_vacio"
                                android:textSize="100sp"
                                android:textColor="@color/blanco_translucido"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/sensor_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_valor_vacio"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_marginTop="16dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Tarjeta Blanca -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardVentilacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:layout_marginTop="350dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="24dp"
                        app:cardUseCompatPadding="true"
                        app:cardCornerRadius="24dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardElevation="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="24dp"
                            android:paddingVertical="20dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Textos columna -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/dashboard_sistema_ventilacion"
                                    android:textColor="@color/azul_claro"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginTop="4dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/dashboard_extractor_label"
                                        android:textColor="@color/black"
                                        android:textSize="18sp"/>

                                    <TextView
                                        android:id="@+id/extractor"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/valor_vacio"
                                        android:textColor="@color/gris_linea"
                                        android:textSize="16sp"
                                        android:textStyle="bold"/>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Icono en columna -->
                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/baseline_mode_fan_off_24"
                                app:tint="@color/gris_icono"/>

                        </LinearLayout> <!-- Fin del contenedor de las dos columnas -->
                    </androidx.cardview.widget.CardView>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Botón para abrir el menú lateral -->
        <ImageView
            android:id="@+id/btnMenuHamburguesa"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="8dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="88dp"
            android:src="@drawable/ic_menu_hamburguesa"
            android:contentDescription="@string/cd_abrir_menu"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>

    <!-- Menú lateral -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/white"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_lateral" />

</androidx.drawerlayout.widget.DrawerLayout>
