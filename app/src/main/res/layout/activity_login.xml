<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center_horizontal"
    android:background="@color/white">

    <!-- Espacio superior -->
    <Space
        android:layout_width="264dp"
        android:layout_height="20dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_bienvenida"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/black" />

    <View
        android:layout_width="100dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"
        android:background="@color/gris_linea" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.1" />

    <!-- Campo Correo -->
    <TextView
        android:layout_width="327dp"
        android:layout_height="wrap_content"
        android:text="@string/label_correo"
        android:textColor="@color/azul_etiqueta"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/correo"
        android:maxLength="254"
        android:layout_width="329dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/gris_linea"
        android:hint="@string/hint_correo"
        android:inputType="textEmailAddress"
        android:paddingVertical="12dp" />

    <!-- Campo Contraseña -->
    <TextView
        android:layout_width="323dp"
        android:layout_height="wrap_content"
        android:text="@string/label_contrasena"
        android:textColor="@color/azul_etiqueta"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/contrasena"
        android:maxLength="64"
        android:layout_width="324dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/gris_linea"
        android:hint="@string/hint_contrasena"
        android:inputType="textPassword"
        android:paddingVertical="12dp" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:text="@string/login_btn_ingresar"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/azul_etiqueta"
        app:cornerRadius="16dp" />

    <TextView
        android:id="@+id/tvOlvide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:text="@string/login_olvide"
        android:textColor="@color/azul_etiqueta"
        android:textSize="16sp" />

    <!-- Espacio inferior -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvCreateAccount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:padding="9dp"
        android:text="@string/crear_cuenta"
        android:textColor="@color/azul_etiqueta"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>