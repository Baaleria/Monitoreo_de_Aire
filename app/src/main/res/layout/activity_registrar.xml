<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/registrar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageButton
            android:id="@+id/tvVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_arrow_back_ios_24"
            android:scaleType="centerInside"
            android:layout_gravity="start"
            android:contentDescription="@string/cd_volver_login" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crear_cuenta"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal" />

        <View
            android:layout_width="100dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/gris_linea" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.3" />

        <!-- Correo Electrónico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_correo"
            android:textColor="@color/azul_etiqueta"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/correo_electronico"
            android:maxLength="254"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_correo"
            android:inputType="textEmailAddress"
            android:backgroundTint="@color/gris_linea"
            android:layout_marginBottom="16dp" />

        <!-- Nombre de Usuario -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/registrar_usuario_label"
            android:textColor="@color/azul_etiqueta"
            android:textSize="17sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/usuario"
            android:maxLength="50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/registrar_usuario_hint"
            android:inputType="text"
            android:backgroundTint="@color/gris_linea"
            android:layout_marginBottom="16dp" />

        <!-- Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_contrasena"
            android:textColor="@color/azul_etiqueta"
            android:textSize="17sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/contrasenareg1"
            android:maxLength="64"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_contrasena"
            android:inputType="textPassword"
            android:backgroundTint="@color/gris_linea"
            android:layout_marginBottom="16dp" />

        <!-- Confirmar Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/registrar_confirmar_label"
            android:textSize="17sp"
            android:textColor="@color/azul_etiqueta"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/contrasenareg2"
            android:maxLength="64"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_contrasena"
            android:inputType="textPassword"
            android:backgroundTint="@color/gris_linea" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botón Crear a la derecha -->
        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:layout_gravity="end"
            android:backgroundTint="@color/azul_etiqueta"
            android:text="@string/registrar_btn_crear"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:cornerRadius="16dp" />

    </LinearLayout>
</LinearLayout>