<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/registrar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageButton
            android:id="@+id/tvVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_arrow_back_ios_24"
            android:scaleType="centerInside"
            android:layout_gravity="start"
            android:contentDescription="Volver al Login" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/textCrearCuenta"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center_horizontal" />

        <View
            android:layout_width="100dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            android:background="#A9A9A9" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.3" />

        <!-- Correo Electrónico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo Electrónico"
            android:textColor="#2196F3"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/Correo_electronico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="correoelectronico@email.com"
            android:inputType="textEmailAddress"
            android:backgroundTint="#A9A9A9"
            android:layout_marginBottom="16dp" />

        <!-- Nombre de Usuario -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre de Usuario"
            android:textColor="#2196F3"
            android:textSize="17sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/usuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Usuario"
            android:inputType="text"
            android:backgroundTint="#A9A9A9"
            android:layout_marginBottom="16dp" />

        <!-- Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textColor="#2196F3"
            android:textSize="17sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/contrasenareg1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="••••••••"
            android:inputType="textPassword"
            android:backgroundTint="#A9A9A9"
            android:layout_marginBottom="16dp" />

        <!-- Confirmar Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar Contraseña"
            android:textSize="17sp"
            android:textColor="#2196F3"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/contrasenareg2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="••••••••"
            android:inputType="textPassword"
            android:backgroundTint="#A9A9A9" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botón Crear a la derecha -->
        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:layout_gravity="end"
            android:backgroundTint="#2196F3"
            android:text="@string/btnCrear"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:cornerRadius="16dp" />

    </LinearLayout>
</LinearLayout>